{
  "_comment": "Copy to config.json and keep only what you need. Every key is optional.",
  "lang": "en",
  "remote": "tailscale",
  "consoles": true,
  "python": "C:\\Python312\\python.exe",
  "codex": "C:\\Users\\you\\AppData\\Roaming\\npm\\codex.cmd",
  "cursorAgent": "C:\\Users\\you\\AppData\\Local\\cursor-agent\\cursor-agent.cmd",
  "usageUrl": "http://127.0.0.1:4777",
  "usageDir": "../ai-usage",
  "locateRoots": [
    "D:\\work"
  ],
  "calendar": {
    "todo": "D:\\notes\\todo.md",
    "events": "D:\\notes\\calendar.json",
    "googleAccount": "you@example.com",
    "timeZone": "America/New_York"
  },
  "gpt": {
    "model": "gpt-5",
    "_comment": "ccd gpt falls back to a Codex session on a Delta Hub (below) when every ChatGPT login is at its limit",
    "hubProject": "<delta hub project id for the fallback sessions>",
    "hubProjects": [
      "<other project ids whose runs share the same quota>"
    ],
    "hubFallback": true
  },
  "secretsDir": "C:\\path\\to\\secrets",
  "antigravity": false,
  "codexAutoSwitch": true,
  "codexAutoPick": true,
  "switchCrossAgentAuto": false,
  "operator": {
    "enabled": true,
    "noticeDeliver": false,
    "checkEveryMin": 180
  },
  "telegram": {
    "_comment": "telegram-bridge.js (main hub only): token in <secretsDir>/ccd-telegram.json {\"token\": \"...\"}; allowed user ids come from the usage dashboard's telegram/.env",
    "home": "<session id prefix that plain messages go to>",
    "secretFile": "C:\\path\\to\\secrets\\ccd-telegram.json"
  },
  "llm": {
    "_comment": "ccd llm / ccd llm agent: an Ollama (or OpenAI-compatible /v1) server, e.g. through a tunnel",
    "url": "http://127.0.0.1:11434",
    "model": "<default model>",
    "fastModel": "<--fast model>",
    "agentModel": "<tool-using model>",
    "agentRoot": "C:\\path\\to\\llm-workspace",
    "hubCwd": "C:\\path\\to\\projects"
  },
  "driveUrl": "http://127.0.0.1:8090",
  "driveLabel": "GX10 드라이브",
  "drives": {
    "nas": {
      "label": "Team share (Z:)",
      "url": "http://127.0.0.1:8091",
      "local": "Z:\\",
      "letter": "Z:",
      "unc": "\\\\fileserver\\share",
      "start": "C:\\path\\to\\start-drive-server.vbs"
    }
  },
  "webApps": [
    {
      "id": "studio",
      "label": "My web app",
      "icon": "🧩",
      "url": "http://127.0.0.1:5180",
      "start": "C:path\tostart-app.vbs",
      "hint": "start it with ..."
    },
    {
      "id": "llm",
      "label": "LLM chat",
      "icon": "💬",
      "url": "http://127.0.0.1:11434",
      "page": "C:path\tollm.html",
      "bridge": "llm-web-bridge.js"
    }
  ],
  "delta": {
    "_comment": "a Deltascale AI Control Hub: portal = login page, hub = the hub itself; the session cookie is kept in <secretsDir>/delta-session.json",
    "portal": "https://hub.example.org:8443",
    "hub": "https://hub.example.org:8444",
    "uiPort": 7790,
    "defaultProject": "<project name or id preselected for new sessions>"
  },
  "nasMirror": "/srv/nas/work/<user>/mirror",
  "homelink": {
    "url": "https://hub.example.org/"
  },
  "dooray": {
    "_comment": "optional read-only Dooray calendar: read through a logged-in Chrome on CDP; calendars: name -> \"all\" | \"mine\"",
    "base": "https://<tenant>.dooray.com",
    "cdp": 9222,
    "me": "<your name tag as written in entries>",
    "calendars": {
      "<calendar name>": "all"
    }
  },
  "gpu": {
    "_comment": "see gpu.js for every key; servers are optional remote GPU boxes reached over ssh",
    "localDisplayReserveMB": 4000,
    "hotC": 85,
    "servers": [
      {
        "id": "bigbox",
        "name": "Big-memory box",
        "ssh": "user@bigbox",
        "key": "C:\\path\\to\\ssh-key",
        "workdir": "/home/user",
        "python": "/home/user/venvs/torch/bin/python",
        "auto": true,
        "speed": 0.35,
        "reserveBaseMB": 56000,
        "envs": {
          "gs": "/home/user/venvs/gs"
        }
      },
      {
        "id": "delta",
        "name": "Slurm cluster",
        "ssh": "user@slurm-controller",
        "workdir": "/work/user/stage",
        "slurm": {
          "partition": "gpu",
          "local": true,
          "stageRoot": "/work/user/stage",
          "nodes": [
            "gpu-w01",
            "gpu-w02"
          ]
        }
      }
    ],
    "blockLocalLlm": false
  },
  "_plugins": "Optional features are plugins (hub/plugins/<id>, docs/PLUGINS.md); each turns on when its keys below are set.",
  "researchHarness": "../research-harness"
}
